# izaro-eye server
PORT=4000
DATA_DIR=./data

# Credentials for the application under test. Referenced by projects as
# {{env:AUT_USERNAME}} / {{env:AUT_PASSWORD}}; never stored in the database.
AUT_USERNAME=admin
AUT_PASSWORD=admin

# jev-img (TypeSafe Jev Box / visual processing). Without a key the server
# falls back to the local heuristic classifier.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.14.0

# Pixel ratio below which two screenshots are treated as identical without
# calling jev-img.
PIXEL_IDENTICAL_THRESHOLD=0.0005
