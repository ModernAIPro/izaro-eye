# izaro-eye server
PORT=4000
DATA_DIR=./data
# Set to `chrome` to drive the locally installed Google Chrome instead of
# Playwright's bundled Chromium.
BROWSER_CHANNEL=

# Secrets for the application under test. Scenarios refer to them as
# {{secret:AUT_PASSWORD}}; values are never stored in the database.
AUT_PASSWORD=admin

# jev-img (TypeSafe Jev Box / visual processing). Without a key only exact
# image matches work and changed screens go to review.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.14.0

# Pixel ratio below which an expected screen counts as identical without
# calling jev-img.
PIXEL_IDENTICAL_THRESHOLD=0.0005
