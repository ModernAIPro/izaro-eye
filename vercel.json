{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.starkfarms.in/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
